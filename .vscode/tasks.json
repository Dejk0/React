{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "vite: dev server",
            "type": "shell",
            "command": "source ~/.nvm/nvm.sh && npm run dev",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE",
                    "endsPattern": "Local:"
                }
            }
        },
        {
            "label": "chrome: debug browser",
            "type": "shell",
            "command": "env -u GSETTINGS_SCHEMA_DIR -u GIO_EXTRA_MODULES -u XDG_DATA_HOME -u GTK_PATH -u GTK_EXE_PREFIX -u GTK_IM_MODULE_FILE -u GIO_MODULE_DIR -u LD_LIBRARY_PATH -u LOCPATH -u GDK_PIXBUF_MODULE_FILE -u GDK_PIXBUF_MODULEDIR -u FONTCONFIG_FILE -u FONTCONFIG_PATH XDG_DATA_DIRS=/usr/local/share:/usr/share google-chrome --remote-debugging-port=9222 --user-data-dir=${workspaceFolder}/.vscode/chrome-profile --no-first-run --no-default-browser-check http://localhost:5173",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "DevTools listening"
                }
            }
        },
        {
            "label": "dev: start",
            "dependsOn": [
                "vite: dev server",
                "chrome: debug browser"
            ],
            "dependsOrder": "sequence"
        }
    ]
}
